# Netlify caches the extensionless URL separately from the file it rewrites to, so
# /events/akvan kept serving an old copy while /events/akvan.html was current. The
# rules below cover every path, which the earlier /*.html pattern did not.
/*
  Cache-Control: no-cache, must-revalidate

/*.html
  Cache-Control: no-cache, must-revalidate

/*.json
  Cache-Control: no-cache, must-revalidate
